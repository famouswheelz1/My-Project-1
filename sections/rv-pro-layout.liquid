{% comment %}
  Reye Vision — High-converting product page
  Conversion structure modelled on leading DTC automotive product pages:
  1.  Sticky announcement bar (urgency)
  2.  Sticky ATC bar (fires after hero leaves viewport)
  3.  Hero: gallery + info column
       – Eyebrow → H1 → rating → media logos → price → bullet features
       → variant/bundle selector → qty → ATC → Buy Now → 4 trust pills
  4.  Social-proof ribbon (units sold / countries / rating)
  5.  Problem section (old solution fails)
  6.  Feature showcase (alternating image + copy)
  7.  "As Seen In" press logos
  8.  Comparison table (Reye Vision vs competitors vs stock mirror)
  9.  How It Works (3-step)
  10. Review aggregate + card grid
  11. FAQ accordion
  12. Guarantee block
  13. Final CTA repeat
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

<!-- ══════════════════════════════════════════════════════
     1. ANNOUNCEMENT / URGENCY BAR
════════════════════════════════════════════════════════ -->
<div class="rp-announce" id="rp-announce">
  <div class="rp-announce__track">
    <span>🔥 LIMITED OFFER — <strong>Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</strong> today only &nbsp;·&nbsp;</span>
    <span>⏰ Deal ends in <strong id="rp-top-timer">--:--:--</strong> &nbsp;·&nbsp;</span>
    <span>🚚 Free Priority Shipping on all orders &nbsp;·&nbsp;</span>
    <span>🔒 100% Secure Checkout &nbsp;·&nbsp;</span>
    <span>🔥 LIMITED OFFER — <strong>Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</strong> today only &nbsp;·&nbsp;</span>
    <span>⏰ Deal ends in <strong>--:--:--</strong> &nbsp;·&nbsp;</span>
    <span>🚚 Free Priority Shipping on all orders &nbsp;·&nbsp;</span>
    <span>🔒 100% Secure Checkout &nbsp;·&nbsp;</span>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     2. STICKY ATC BAR (hidden until hero scrolls out)
════════════════════════════════════════════════════════ -->
<div class="rp-sticky-bar" id="rp-sticky-bar" aria-hidden="true">
  <div class="rp-container rp-sticky-bar__inner">
    <div class="rp-sticky-bar__product">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 60 }}" alt="{{ product.title | escape }}" width="60" height="60" loading="lazy">
      {% endif %}
      <div>
        <strong>{{ product.title }}</strong>
        <span class="rp-sticky-bar__rating">★★★★★ 4.9 (2,841)</span>
      </div>
    </div>
    <div class="rp-sticky-bar__price">
      {% if current_variant.compare_at_price > current_variant.price %}
        <s>{{ current_variant.compare_at_price | money }}</s>
      {% endif %}
      <strong>{{ current_variant.price | money }}</strong>
    </div>
    <button class="rp-btn rp-btn--primary rp-sticky-bar__cta" onclick="document.getElementById('rp-atc-form').requestSubmit()">
      Add to Cart
    </button>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     3. HERO SECTION
════════════════════════════════════════════════════════ -->
<section class="rp-hero" id="rp-hero">
  <div class="rp-container rp-hero__grid">

    <!-- Gallery -->
    <div class="rp-gallery">
      <div class="rp-gallery__main">
        {% if product.featured_media %}
          <img
            id="rp-main-img"
            src="{{ product.featured_media | image_url: width: 1000 }}"
            alt="{{ product.featured_media.alt | escape }}"
            width="1000" height="1000"
            loading="eager"
            class="rp-gallery__main-img"
          >
        {% endif %}
        {% if current_variant.compare_at_price > current_variant.price %}
          {% assign pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round %}
          <span class="rp-gallery__badge">{{ pct }}% OFF</span>
        {% endif %}
      </div>
      <div class="rp-gallery__thumbs" id="rp-thumbs">
        {% for media in product.media limit: 7 %}
          <button
            class="rp-thumb{% if forloop.first %} rp-thumb--active{% endif %}"
            data-src="{{ media | image_url: width: 1000 }}"
            aria-label="Image {{ forloop.index }}"
          >
            <img src="{{ media | image_url: width: 120 }}" alt="{{ media.alt | escape }}" width="120" height="120" loading="lazy">
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- Info column -->
    <div class="rp-info">
      <p class="rp-info__eyebrow">THE #1 SMART MIRROR UPGRADE FOR DRIVERS</p>
      <h1 class="rp-info__title">{{ product.title }}</h1>
      <p class="rp-info__tagline">See everything. Record everything. Never get caught off guard again.</p>

      <!-- Rating + review count -->
      <div class="rp-rating">
        <span class="rp-rating__stars" aria-label="4.9 out of 5 stars">★★★★★</span>
        <a href="#rp-reviews" class="rp-rating__count">4.9 / 5 &nbsp;(2,841 verified reviews)</a>
        <span class="rp-rating__pill">✔ Verified</span>
      </div>

      <!-- As seen in — inline logo strip -->
      <div class="rp-press-inline">
        <span class="rp-press-inline__label">As Seen In:</span>
        <div class="rp-press-inline__logos">
          <span class="rp-press-logo">Forbes</span>
          <span class="rp-press-logo">Road&Track</span>
          <span class="rp-press-logo">MotorTrend</span>
          <span class="rp-press-logo">TechCrunch</span>
        </div>
      </div>

      <!-- Price block -->
      <div class="rp-price-block">
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="rp-price__was">{{ current_variant.compare_at_price | money }}</span>
          <span class="rp-price__now">{{ current_variant.price | money }}</span>
          <span class="rp-price__save-badge">
            YOU SAVE {{ current_variant.compare_at_price | minus: current_variant.price | money }}
          </span>
        {% else %}
          <span class="rp-price__now">{{ current_variant.price | money }}</span>
        {% endif %}
        <p class="rp-price__installment">
          or 4 interest-free payments of
          <strong>{{ current_variant.price | divided_by: 4 | money }}</strong>
          with <span class="rp-price__shop-pay">Shop Pay</span>
        </p>
      </div>

      <!-- Stock urgency -->
      <div class="rp-stock-signal">
        <span class="rp-stock-signal__dot"></span>
        <span><strong>Selling fast</strong> — only <strong>{{ section.settings.units_left | default: 11 }} units</strong> left at this price.</span>
      </div>

      <!-- Bullet features -->
      <ul class="rp-bullets">
        <li>👁️ <strong>170° blindspot-free</strong> digital rearview mirror</li>
        <li>📹 <strong>4K front + rear</strong> continuous dash cam recording</li>
        <li>📡 <strong>Built-in GPS tracker</strong> — speed, route & location stamped on every clip</li>
        <li>🖥️ <strong>9.3" touch IPS display</strong> — glare-free, night-vision ready</li>
        <li>⚡ <strong>2-minute install</strong> — clips over your existing mirror, no tools</li>
        <li>🛡️ <strong>Insurance fraud protection</strong> — irrefutable dual-angle video proof</li>
      </ul>

      <!-- Bundle / variant selector -->
      {% unless product.has_only_default_variant %}
        <div class="rp-variants">
          {% for option in product.options_with_values %}
            <div class="rp-option">
              <p class="rp-option__label">
                {{ option.name }}: <strong id="rp-opt-{{ forloop.index }}">{{ option.selected_value }}</strong>
              </p>
              <div class="rp-option__btns">
                {% for value in option.values %}
                  <button
                    class="rp-opt-btn{% if option.selected_value == value %} rp-opt-btn--active{% endif %}"
                    data-opt-idx="{{ forloop.parentloop.index0 }}"
                    data-value="{{ value | escape }}"
                  >{{ value }}</button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endunless %}

      <!-- Quantity + ATC form -->
      <form action="/cart/add" method="post" id="rp-atc-form" class="rp-purchase-form">
        <input type="hidden" name="id" id="rp-vid" value="{{ current_variant.id }}">

        <div class="rp-purchase-row">
          <div class="rp-qty">
            <button type="button" class="rp-qty__btn" id="rp-minus" aria-label="Decrease">−</button>
            <input type="number" name="quantity" id="rp-qty-val" class="rp-qty__input" value="1" min="1" max="10">
            <button type="button" class="rp-qty__btn" id="rp-plus" aria-label="Increase">+</button>
          </div>

          <button
            type="submit"
            class="rp-btn rp-btn--primary rp-btn--atc{% unless current_variant.available %} rp-btn--disabled{% endunless %}"
            id="rp-atc-btn"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              🛒 Add to Cart — {{ current_variant.price | money }}
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>
      </form>

      <button class="rp-btn rp-btn--secondary rp-btn--buy-now" id="rp-buy-now">
        ⚡ Buy Now — Instant Checkout
      </button>

      <!-- 4 Trust pills -->
      <div class="rp-trust-pills">
        <div class="rp-trust-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
          <span>60-Day<br>Money Back</span>
        </div>
        <div class="rp-trust-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span>Free<br>Shipping</span>
        </div>
        <div class="rp-trust-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Secure<br>Checkout</span>
        </div>
        <div class="rp-trust-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          <span>1-Year<br>Warranty</span>
        </div>
      </div>

      <!-- Payment icons -->
      <p class="rp-payment-icons">
        <img src="{{ 'payment-icons.png' | asset_url }}" alt="Visa, Mastercard, Amex, PayPal, Shop Pay" height="24" loading="lazy"
          onerror="this.replaceWith(document.createTextNode('Visa · Mastercard · Amex · PayPal · Shop Pay'))">
      </p>
    </div><!-- /rp-info -->

  </div><!-- /rp-hero__grid -->
</section>

<!-- ══════════════════════════════════════════════════════
     4. SOCIAL PROOF RIBBON
════════════════════════════════════════════════════════ -->
<div class="rp-ribbon">
  <div class="rp-container rp-ribbon__inner">
    <div class="rp-ribbon__stat">
      <strong>28,000+</strong>
      <span>Drivers Protected</span>
    </div>
    <div class="rp-ribbon__divider"></div>
    <div class="rp-ribbon__stat">
      <strong>4.9 ★</strong>
      <span>Average Rating</span>
    </div>
    <div class="rp-ribbon__divider"></div>
    <div class="rp-ribbon__stat">
      <strong>40+</strong>
      <span>Countries Shipped</span>
    </div>
    <div class="rp-ribbon__divider"></div>
    <div class="rp-ribbon__stat">
      <strong>&lt; 1%</strong>
      <span>Return Rate</span>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════
     5. THE PROBLEM SECTION
════════════════════════════════════════════════════════ -->
<section class="rp-section rp-problem">
  <div class="rp-container rp-problem__grid">
    <div class="rp-problem__copy">
      <p class="rp-eyebrow">WHY YOUR CURRENT MIRROR IS FAILING YOU</p>
      <h2 class="rp-h2">Blind Spots Kill. Your Mirror Knows It.</h2>
      <p class="rp-lead">
        The rearview mirror in your car covers barely <strong>30° of your surroundings</strong>.
        Lane changes, reversing, parallel parking — every one is a gamble with what you can't see.
        And road scammers have figured this out.
      </p>
      <div class="rp-problem__cards">
        <div class="rp-problem-card rp-problem-card--red">
          <span class="rp-problem-card__icon">⚠️</span>
          <p><strong>Staged accidents are up 45%</strong> — fraudsters target drivers who can't prove what happened</p>
        </div>
        <div class="rp-problem-card rp-problem-card--red">
          <span class="rp-problem-card__icon">⚠️</span>
          <p><strong>Blind-spot crashes cause 840,000+ incidents per year</strong> in the US alone</p>
        </div>
        <div class="rp-problem-card rp-problem-card--red">
          <span class="rp-problem-card__icon">⚠️</span>
          <p><strong>Single dash cams only cover the front</strong> — everything behind you is unprotected</p>
        </div>
        <div class="rp-problem-card rp-problem-card--red">
          <span class="rp-problem-card__icon">⚠️</span>
          <p><strong>No GPS = no proof</strong> — speed and location data wins insurance disputes</p>
        </div>
      </div>
    </div>
    <div class="rp-problem__visual">
      <div class="rp-fov-diagram">
        <div class="rp-fov-diagram__bad">
          <div class="rp-fov-arc rp-fov-arc--small"></div>
          <p class="rp-fov-diagram__label">Traditional Mirror</p>
          <p class="rp-fov-diagram__deg">~30°</p>
          <p class="rp-fov-diagram__sub">field of view</p>
        </div>
        <div class="rp-fov-diagram__vs">VS</div>
        <div class="rp-fov-diagram__good">
          <div class="rp-fov-arc rp-fov-arc--large"></div>
          <p class="rp-fov-diagram__label">Reye Vision</p>
          <p class="rp-fov-diagram__deg" style="color:#2a9d8f">170°</p>
          <p class="rp-fov-diagram__sub">field of view</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     6. FEATURE SHOWCASE — alternating image + copy
════════════════════════════════════════════════════════ -->
<section class="rp-section rp-section--gray rp-features">
  <div class="rp-container">
    <p class="rp-eyebrow" style="text-align:center">WHAT'S INSIDE REYE VISION</p>
    <h2 class="rp-h2" style="text-align:center">4 Layers of Protection. One Device.</h2>

    {% assign features = "blindspot,camera,mirror,gps" | split: "," %}

    <div class="rp-feature-row">
      <div class="rp-feature-row__media">
        <div class="rp-feature-row__img-placeholder rp-feature-row__img-placeholder--1">
          {{ 'feature-blindspot.jpg' | asset_url | img_tag: 'Blindspot elimination', 'rp-feature-row__img', loading: 'lazy', width: 600, height: 480 }}
        </div>
      </div>
      <div class="rp-feature-row__copy">
        <span class="rp-feature-tag">FEATURE 01</span>
        <h3>Blindspot Elimination</h3>
        <p>The 170° ultra-wide rear camera wraps around your field of vision to reveal every angle your stock mirror hides. See cyclists, pedestrians, and merging vehicles that would otherwise be invisible — before they become a problem.</p>
        <ul class="rp-feature-list">
          <li>✓ Ultra-wide 170° rear lens</li>
          <li>✓ Night-vision enhanced sensor</li>
          <li>✓ Weather-sealed, fits any vehicle</li>
        </ul>
      </div>
    </div>

    <div class="rp-feature-row rp-feature-row--reverse">
      <div class="rp-feature-row__media">
        <div class="rp-feature-row__img-placeholder rp-feature-row__img-placeholder--2">
          {{ 'feature-dashcam.jpg' | asset_url | img_tag: 'Dual channel recording', 'rp-feature-row__img', loading: 'lazy', width: 600, height: 480 }}
        </div>
      </div>
      <div class="rp-feature-row__copy">
        <span class="rp-feature-tag">FEATURE 02</span>
        <h3>Front & Rear 4K Recording</h3>
        <p>Continuous dual-channel recording captures every second — front and back — at 4K clarity. If someone rear-ends you, cuts you off, or stages a brake-check, you have irrefutable video proof ready to share instantly.</p>
        <ul class="rp-feature-list">
          <li>✓ 4K front + 1080p rear simultaneous</li>
          <li>✓ Loop recording — never miss a moment</li>
          <li>✓ G-sensor auto-locks incident clips</li>
        </ul>
      </div>
    </div>

    <div class="rp-feature-row">
      <div class="rp-feature-row__media">
        <div class="rp-feature-row__img-placeholder rp-feature-row__img-placeholder--3">
          {{ 'feature-display.jpg' | asset_url | img_tag: 'Digital rearview mirror', 'rp-feature-row__img', loading: 'lazy', width: 600, height: 480 }}
        </div>
      </div>
      <div class="rp-feature-row__copy">
        <span class="rp-feature-tag">FEATURE 03</span>
        <h3>Digital Rearview Mirror</h3>
        <p>A 9.3" full-touch IPS display replaces the grainy reflection you've been squinting at for years. Razor-sharp live feed from the rear camera. No headrests blocking the view. No glare. No blind spots.</p>
        <ul class="rp-feature-list">
          <li>✓ 9.3" IPS touch display</li>
          <li>✓ Auto brightness — day & night modes</li>
          <li>✓ Clips over your existing mirror in 2 min</li>
        </ul>
      </div>
    </div>

    <div class="rp-feature-row rp-feature-row--reverse">
      <div class="rp-feature-row__media">
        <div class="rp-feature-row__img-placeholder rp-feature-row__img-placeholder--4">
          {{ 'feature-gps.jpg' | asset_url | img_tag: 'Built-in GPS', 'rp-feature-row__img', loading: 'lazy', width: 600, height: 480 }}
        </div>
      </div>
      <div class="rp-feature-row__copy">
        <span class="rp-feature-tag">FEATURE 04</span>
        <h3>Built-In GPS Tracker</h3>
        <p>Real-time speed data and GPS coordinates are stamped on every video clip. If there's ever a dispute — insurance, police, or legal — you have date, time, location, and exact speed locked to the footage. Scammers hate this.</p>
        <ul class="rp-feature-list">
          <li>✓ Real-time GPS speed overlay</li>
          <li>✓ Route history stored on device</li>
          <li>✓ Location-stamped on every clip</li>
        </ul>
      </div>
    </div>

  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     7. AS SEEN IN — PRESS LOGOS
════════════════════════════════════════════════════════ -->
