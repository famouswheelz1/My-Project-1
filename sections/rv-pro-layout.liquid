<!-- ══════════════════════════════════════════════════════
     STYLES
════════════════════════════════════════════════════════ -->
<style>
/* ── Reset ───────────────────────────────────────────── */
.rp-page *, .rp-page *::before, .rp-page *::after { box-sizing: border-box; }
* { box-sizing: border-box; }

/* ── Tokens ──────────────────────────────────────────── */
:root {
  --rv-red:    #e63946;
  --rv-dark:   #1a1a2e;
  --rv-teal:   #2a9d8f;
  --rv-gold:   #f4a61c;
  --rv-gray:   #f8f9fa;
  --rv-text:   #2d2d2d;
  --rv-muted:  #666;
  --rv-border: #e0e0e0;
  --rv-radius: 10px;
}

/* ── Base ────────────────────────────────────────────── */
.rp-container { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
.rp-section   { padding: 72px 0; }
.rp-section--gray { background: var(--rv-gray); }
.rp-section--dark { background: var(--rv-dark); color: #fff; }
.rp-eyebrow   { font-size: 11px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--rv-red); margin-bottom: 10px; }
.rp-eyebrow--light { color: var(--rv-gold); }
.rp-h2        { font-size: clamp(24px, 3.5vw, 38px); font-weight: 900; line-height: 1.15; margin-bottom: 20px; color: var(--rv-dark); }
.rp-h2--light { color: #fff; }
.rp-lead      { font-size: 17px; color: var(--rv-muted); margin-bottom: 24px; line-height: 1.7; }

/* ── Buttons ─────────────────────────────────────────── */
.rp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: none; border-radius: var(--rv-radius); font-weight: 800; cursor: pointer; transition: transform .15s, box-shadow .15s; font-size: 17px; padding: 15px 28px; text-align: center; }
.rp-btn--primary  { background: linear-gradient(135deg, var(--rv-red), #c1121f); color: #fff; box-shadow: 0 4px 18px rgba(230,57,70,.4); width: 100%; }
.rp-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 7px 22px rgba(230,57,70,.5); }
.rp-btn--secondary { background: var(--rv-dark); color: #fff; width: 100%; margin-top: 10px; }
.rp-btn--secondary:hover { background: #2d2d4e; }
.rp-btn--atc  { flex: 1; font-size: 18px; }
.rp-btn--disabled { background: #aaa !important; box-shadow: none !important; cursor: not-allowed; }
.rp-btn--xl   { font-size: 20px; padding: 18px 36px; max-width: 480px; }

/* ── Announce bar ────────────────────────────────────── */
.rp-announce { background: var(--rv-dark); color: #fff; overflow: hidden; padding: 10px 0; font-size: 13px; }
.rp-announce__track { display: flex; gap: 0; white-space: nowrap; animation: rp-scroll 30s linear infinite; }
.rp-announce__track span { padding: 0 6px; }
@keyframes rp-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

/* ── Sticky ATC bar ──────────────────────────────────── */
.rp-sticky-bar { position: fixed; top: 0; left: 0; right: 0; z-index: 9000; background: #fff; border-bottom: 1px solid var(--rv-border); box-shadow: 0 2px 16px rgba(0,0,0,.12); transform: translateY(-100%); transition: transform .3s ease; }
.rp-sticky-bar.rp-sticky-bar--visible { transform: translateY(0); }
.rp-sticky-bar__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 10px 20px; flex-wrap: wrap; }
.rp-sticky-bar__product { display: flex; align-items: center; gap: 12px; }
.rp-sticky-bar__product img { border-radius: 6px; object-fit: cover; }
.rp-sticky-bar__rating { display: block; font-size: 12px; color: var(--rv-gold); }
.rp-sticky-bar__price { font-size: 18px; }
.rp-sticky-bar__price s { color: var(--rv-muted); font-size: 14px; margin-right: 6px; }
.rp-sticky-bar__cta { width: auto; padding: 10px 24px; font-size: 15px; }

/* ── Hero ────────────────────────────────────────────── */
.rp-hero { padding: 40px 0 56px; }
.rp-hero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: start; }
@media (max-width: 780px) { .rp-hero__grid { grid-template-columns: 1fr; } }

/* Gallery */
.rp-gallery__main { position: relative; border-radius: 14px; overflow: hidden; background: var(--rv-gray); aspect-ratio: 1; }
.rp-gallery__main-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rp-gallery__badge { position: absolute; top: 14px; left: 14px; background: var(--rv-red); color: #fff; font-size: 13px; font-weight: 800; padding: 4px 10px; border-radius: 6px; }
.rp-gallery__thumbs { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.rp-thumb { width: 76px; height: 76px; border: 2px solid transparent; border-radius: 8px; overflow: hidden; cursor: pointer; background: none; padding: 0; flex-shrink: 0; transition: border-color .2s; }
.rp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rp-thumb--active { border-color: var(--rv-red); }

/* Info */
.rp-info__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--rv-red); margin-bottom: 6px; }
.rp-info__title   { font-size: clamp(26px, 4vw, 40px); font-weight: 900; line-height: 1.1; margin-bottom: 8px; color: var(--rv-dark); }
.rp-info__tagline { font-size: 17px; color: var(--rv-muted); margin-bottom: 14px; }

/* Rating */
.rp-rating { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
.rp-rating__stars { color: var(--rv-gold); font-size: 20px; letter-spacing: 1px; }
.rp-rating__count { font-size: 13px; font-weight: 600; color: var(--rv-dark); border-bottom: 1px solid currentColor; text-decoration: none; }
.rp-rating__pill  { background: #e6f9f7; color: var(--rv-teal); font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 20px; }

/* Inline press */
.rp-press-inline { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
.rp-press-inline__label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--rv-muted); }
.rp-press-inline__logos { display: flex; gap: 14px; flex-wrap: wrap; }
.rp-press-logo { font-size: 13px; font-weight: 800; color: #999; font-style: italic; }

/* Price */
.rp-price-block { margin-bottom: 16px; }
.rp-price__was  { font-size: 18px; color: #bbb; text-decoration: line-through; margin-right: 10px; }
.rp-price__now  { font-size: 34px; font-weight: 900; color: var(--rv-red); }
.rp-price__now--xl { font-size: 44px; }
.rp-price__save-badge { display: inline-block; background: var(--rv-red); color: #fff; font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: 4px; margin-left: 10px; vertical-align: middle; letter-spacing: .5px; }
.rp-price__installment { font-size: 13px; color: var(--rv-muted); margin-top: 6px; }
.rp-price__shop-pay { font-weight: 700; color: #5a31f4; }

/* Stock */
.rp-stock-signal { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #c1121f; margin-bottom: 18px; }
.rp-stock-signal__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--rv-red); animation: rp-pulse 1.5s infinite; flex-shrink: 0; }
@keyframes rp-pulse { 0%,100%{ opacity:1; transform:scale(1); } 50%{ opacity:.5; transform:scale(1.3); } }

/* Bullets */
.rp-bullets { list-style: none; padding: 0; margin-bottom: 22px; }
.rp-bullets li { padding: 5px 0; font-size: 14px; color: var(--rv-text); line-height: 1.5; }

/* Variants */
.rp-variants { margin-bottom: 18px; }
.rp-option { margin-bottom: 14px; }
.rp-option__label { font-size: 14px; font-weight: 600; margin-bottom: 8px; }
.rp-option__btns  { display: flex; gap: 8px; flex-wrap: wrap; }
.rp-opt-btn { padding: 8px 16px; border: 2px solid var(--rv-border); border-radius: 6px; font-size: 14px; cursor: pointer; background: #fff; transition: all .2s; }
.rp-opt-btn:hover, .rp-opt-btn--active { border-color: var(--rv-red); background: #fff0f0; font-weight: 700; }

/* Purchase form */
.rp-purchase-form { margin-bottom: 10px; }
.rp-purchase-row  { display: flex; gap: 12px; align-items: stretch; }
.rp-qty { display: flex; align-items: center; border: 2px solid var(--rv-border); border-radius: 8px; overflow: hidden; flex-shrink: 0; }
.rp-qty__btn   { width: 42px; height: 54px; background: var(--rv-gray); border: none; font-size: 22px; cursor: pointer; }
.rp-qty__btn:hover { background: #eee; }
.rp-qty__input { width: 50px; height: 54px; border: none; text-align: center; font-size: 16px; font-weight: 700; -moz-appearance: textfield; }
.rp-qty__input::-webkit-inner-spin-button, .rp-qty__input::-webkit-outer-spin-button { -webkit-appearance: none; }

/* Trust pills */
.rp-trust-pills { display: flex; gap: 10px; margin: 18px 0 14px; flex-wrap: wrap; }
.rp-trust-pill  { display: flex; align-items: center; gap: 8px; border: 1px solid var(--rv-border); border-radius: 8px; padding: 8px 12px; font-size: 12px; font-weight: 600; flex: 1; min-width: 100px; color: var(--rv-text); }
.rp-trust-pill svg { width: 18px; height: 18px; color: var(--rv-teal); flex-shrink: 0; }

.rp-payment-icons { font-size: 12px; color: var(--rv-muted); margin-top: 8px; }

/* ── Ribbon ──────────────────────────────────────────── */
.rp-ribbon { background: var(--rv-dark); color: #fff; padding: 28px 0; }
.rp-ribbon__inner { display: flex; align-items: center; justify-content: space-around; flex-wrap: wrap; gap: 20px; text-align: center; }
.rp-ribbon__stat strong { display: block; font-size: 30px; font-weight: 900; color: var(--rv-gold); }
.rp-ribbon__stat span   { font-size: 13px; color: #ccc; }
.rp-ribbon__divider { width: 1px; height: 40px; background: rgba(255,255,255,.15); }
@media (max-width: 600px) { .rp-ribbon__divider { display: none; } }

/* ── Problem ─────────────────────────────────────────── */
.rp-problem { padding: 72px 0; }
.rp-problem__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; }
@media (max-width: 780px) { .rp-problem__grid { grid-template-columns: 1fr; } }
.rp-problem__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
@media (max-width: 500px) { .rp-problem__cards { grid-template-columns: 1fr; } }
.rp-problem-card { padding: 14px; border-radius: 8px; font-size: 13px; line-height: 1.55; }
.rp-problem-card--red { background: #fff0f0; border-left: 3px solid var(--rv-red); }
.rp-problem-card__icon { font-size: 18px; margin-right: 6px; }

.rp-fov-diagram { display: flex; align-items: center; gap: 16px; justify-content: center; }
.rp-fov-diagram__bad, .rp-fov-diagram__good { text-align: center; padding: 24px 20px; border-radius: 12px; flex: 1; }
.rp-fov-diagram__bad  { background: #fff0f0; border: 2px solid #ffccd0; }
.rp-fov-diagram__good { background: #f0faf8; border: 2px solid #2a9d8f; }
.rp-fov-diagram__vs   { font-size: 18px; font-weight: 900; color: #aaa; }
.rp-fov-diagram__label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
.rp-fov-diagram__deg  { font-size: 52px; font-weight: 900; color: var(--rv-red); line-height: 1; }
.rp-fov-diagram__sub  { font-size: 12px; color: var(--rv-muted); }
.rp-fov-arc { width: 80px; height: 40px; border-radius: 80px 80px 0 0; margin: 0 auto 8px; }
.rp-fov-arc--small { background: rgba(230,57,70,.25); width: 30px; }
.rp-fov-arc--large { background: rgba(42,157,143,.25); }

/* ── Feature rows ────────────────────────────────────── */
.rp-feature-row { display: grid; grid-template-columns: 1fr 1fr; gap: 52px; align-items: center; margin-bottom: 72px; }
.rp-feature-row:last-child { margin-bottom: 0; }
.rp-feature-row--reverse { direction: rtl; }
.rp-feature-row--reverse > * { direction: ltr; }
@media (max-width: 780px) { .rp-feature-row, .rp-feature-row--reverse { grid-template-columns: 1fr; direction: ltr; } }
.rp-feature-row__img-placeholder { border-radius: 14px; overflow: hidden; background: linear-gradient(135deg, #1a1a2e 0%, #2d2d4e 100%); aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.15); font-size: 13px; }
.rp-feature-row__img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rp-feature-tag { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--rv-teal); margin-bottom: 10px; display: block; }
.rp-feature-row__copy h3 { font-size: 26px; font-weight: 800; margin-bottom: 14px; color: var(--rv-dark); }
.rp-feature-row__copy p  { font-size: 15px; color: var(--rv-muted); line-height: 1.7; margin-bottom: 16px; }
.rp-feature-list { list-style: none; padding: 0; }
.rp-feature-list li { font-size: 14px; color: var(--rv-text); padding: 4px 0; font-weight: 600; }

/* ── Press ───────────────────────────────────────────── */
.rp-press { padding: 44px 0; background: var(--rv-gray); text-align: center; border-top: 1px solid var(--rv-border); border-bottom: 1px solid var(--rv-border); }
.rp-press__label { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--rv-muted); margin-bottom: 18px; }
.rp-press__logos { display: flex; align-items: center; justify-content: center; gap: 40px; flex-wrap: wrap; margin-bottom: 22px; }
.rp-press__logo-name { font-size: 18px; font-weight: 900; color: #bbb; font-style: italic; }
.rp-press__quote { font-size: 16px; color: var(--rv-muted); font-style: italic; max-width: 580px; margin: 0 auto; }
.rp-press__quote cite { display: block; font-size: 13px; font-weight: 700; color: var(--rv-dark); margin-top: 8px; font-style: normal; }

/* ── Comparison table ────────────────────────────────── */
.rp-compare { padding: 72px 0; }
.rp-table-wrap { overflow-x: auto; margin-top: 32px; }
.rp-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.rp-table th, .rp-table td { padding: 14px 20px; text-align: center; border-bottom: 1px solid var(--rv-border); }
.rp-table th { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; background: var(--rv-gray); }
.rp-table th:first-child, .rp-table td:first-child { text-align: left; font-weight: 600; }
.rp-table__col--us { background: rgba(230,57,70,.05); font-size: 18px; }
.rp-table th.rp-table__col--us { background: var(--rv-red); color: #fff; }
.rp-table tr:hover td { background: #fafafa; }

/* ── How it works ────────────────────────────────────── */
.rp-hiw { padding: 72px 0; }
.rp-hiw__steps { display: flex; align-items: flex-start; gap: 20px; margin-top: 40px; flex-wrap: wrap; }
.rp-hiw__step { flex: 1; min-width: 200px; }
.rp-hiw__num  { font-size: 52px; font-weight: 900; color: rgba(255,255,255,.12); line-height: 1; margin-bottom: 10px; }
.rp-hiw__step h3 { font-size: 20px; font-weight: 800; color: #fff; margin-bottom: 10px; }
.rp-hiw__step p  { font-size: 14px; color: rgba(255,255,255,.65); line-height: 1.7; }
.rp-hiw__arrow { font-size: 28px; color: rgba(255,255,255,.3); padding-top: 24px; flex-shrink: 0; }
@media (max-width: 600px) { .rp-hiw__arrow { display: none; } }

/* ── Reviews ─────────────────────────────────────────── */
.rp-reviews__agg { display: flex; align-items: flex-start; gap: 40px; background: var(--rv-gray); border-radius: 14px; padding: 28px; margin-bottom: 40px; flex-wrap: wrap; }
.rp-reviews__score-block { text-align: center; }
.rp-reviews__big-score { display: block; font-size: 64px; font-weight: 900; line-height: 1; color: var(--rv-dark); }
.rp-reviews__big-stars  { display: block; font-size: 26px; color: var(--rv-gold); letter-spacing: 2px; }
.rp-reviews__total      { font-size: 12px; color: var(--rv-muted); }
.rp-reviews__bars { flex: 1; min-width: 180px; }
.rp-bar-row   { display: flex; align-items: center; gap: 8px; font-size: 12px; margin-bottom: 5px; }
.rp-bar-track { flex: 1; height: 8px; background: #e0e0e0; border-radius: 4px; overflow: hidden; }
.rp-bar-fill  { height: 100%; background: var(--rv-gold); border-radius: 4px; }
.rp-reviews__highlights { min-width: 200px; }
.rp-reviews__hl { font-size: 13px; color: var(--rv-text); padding: 5px 0; border-bottom: 1px solid var(--rv-border); }
.rp-reviews__hl:last-child { border-bottom: none; }

.rp-reviews__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 36px; }
.rp-review-card { border: 1px solid var(--rv-border); border-radius: 12px; padding: 24px; background: #fff; }
.rp-review-card--featured { border-color: var(--rv-red); background: #fff8f8; }
.rp-review-card__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.rp-review-card__stars   { color: var(--rv-gold); font-size: 17px; }
.rp-review-card__verified { font-size: 11px; color: var(--rv-teal); font-weight: 700; }
.rp-review-card__title { font-size: 15px; font-weight: 800; margin-bottom: 10px; color: var(--rv-dark); }
.rp-review-card__body  { font-size: 13px; color: #555; line-height: 1.65; font-style: italic; margin-bottom: 16px; }
.rp-review-card__author { display: flex; align-items: center; gap: 12px; }
.rp-review-card__avatar { width: 42px; height: 42px; border-radius: 50%; background: var(--rv-dark); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; flex-shrink: 0; }
.rp-review-card__author strong { display: block; font-size: 14px; }
.rp-review-card__date { font-size: 11px; color: var(--rv-muted); }
.rp-reviews__cta-row { text-align: center; }
.rp-reviews__cta-row .rp-btn { max-width: 380px; margin: 0 auto; }

/* ── FAQ ─────────────────────────────────────────────── */
.rp-faq__inner { max-width: 760px; margin: 0 auto; }
.rp-faq__list  { margin-top: 36px; }
.rp-faq__item  { border-bottom: 1px solid var(--rv-border); }
.rp-faq__q     { width: 100%; background: none; border: none; display: flex; justify-content: space-between; align-items: center; padding: 18px 0; font-size: 16px; font-weight: 700; cursor: pointer; text-align: left; gap: 16px; color: var(--rv-dark); }
.rp-faq__chevron { width: 20px; height: 20px; flex-shrink: 0; transition: transform .25s; }
.rp-faq__q[aria-expanded="true"] .rp-faq__chevron { transform: rotate(180deg); }
.rp-faq__a     { overflow: hidden; max-height: 0; transition: max-height .35s ease; }
.rp-faq__a p   { padding: 0 0 18px; font-size: 14px; color: var(--rv-muted); line-height: 1.7; }

/* ── Guarantee ───────────────────────────────────────── */
.rp-guarantee { padding: 72px 0; background: var(--rv-dark); color: #fff; }
.rp-guarantee__grid { display: grid; grid-template-columns: auto 1fr; gap: 56px; align-items: center; }
@media (max-width: 640px) { .rp-guarantee__grid { grid-template-columns: 1fr; text-align: center; } }
.rp-guarantee__badge-wrap { display: flex; justify-content: center; }
.rp-guarantee__badge { width: 190px; height: 190px; border-radius: 50%; border: 5px solid var(--rv-gold); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 16px; }
.rp-guarantee__badge-num  { font-size: 60px; font-weight: 900; color: var(--rv-gold); line-height: 1; }
.rp-guarantee__badge-unit { font-size: 16px; font-weight: 700; color: var(--rv-gold); letter-spacing: 2px; }
.rp-guarantee__badge-text { font-size: 12px; font-weight: 800; color: #fff; letter-spacing: 1px; margin-top: 4px; }
.rp-guarantee__copy .rp-h2 { color: #fff; }
.rp-guarantee__copy p { color: rgba(255,255,255,.75); font-size: 15px; margin-bottom: 14px; line-height: 1.7; }
.rp-guarantee__icons { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 18px; }
.rp-guarantee__icons span { font-size: 14px; color: var(--rv-gold); font-weight: 600; }

/* ── Final CTA ───────────────────────────────────────── */
.rp-final-cta { padding: 80px 0; background: var(--rv-gray); }
.rp-final-cta__inner { max-width: 560px; margin: 0 auto; text-align: center; }
.rp-final-cta__sub { font-size: 16px; color: var(--rv-muted); margin-bottom: 24px; }
.rp-final-cta__price-row { margin-bottom: 24px; }
.rp-final-cta__trust { font-size: 12px; color: var(--rv-muted); margin-top: 18px; line-height: 2; }
</style>


<!-- ══════════════════════════════════════════════════════
     SCRIPTS
════════════════════════════════════════════════════════ -->
<script>
(function () {
  'use strict';

  /* ── Countdown (to midnight) ──────────────────────── */
  function countdown(ids) {
    var end = new Date(); end.setHours(23,59,59,999);
    (function tick() {
      var diff = end - Date.now();
      if (diff < 0) diff = 0;
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      var str = (h ? pad(h) + 'h ' : '') + pad(m) + 'm ' + pad(s) + 's';
      ids.forEach(function(id){ var el=document.getElementById(id); if(el) el.textContent=str; });
      if (diff > 0) setTimeout(tick, 1000);
    })();
  }
  function pad(n){ return n < 10 ? '0'+n : n; }
  countdown(['rp-top-timer','rp-final-timer']);

  /* ── Sticky ATC bar ────────────────────────────────── */
  var hero = document.getElementById('rp-hero');
  var stickyBar = document.getElementById('rp-sticky-bar');
  if (hero && stickyBar) {
    var obs = new IntersectionObserver(function(entries){
      stickyBar.classList.toggle('rp-sticky-bar--visible', !entries[0].isIntersecting);
      stickyBar.setAttribute('aria-hidden', entries[0].isIntersecting ? 'true' : 'false');
    }, { threshold: 0 });
    obs.observe(hero);
  }

  /* ── Gallery thumbs ────────────────────────────────── */
  var mainImg = document.getElementById('rp-main-img');
  document.querySelectorAll('.rp-thumb').forEach(function(t){
    t.addEventListener('click', function(){
      if (mainImg) mainImg.src = this.dataset.src;
      document.querySelectorAll('.rp-thumb').forEach(function(x){ x.classList.remove('rp-thumb--active'); });
      this.classList.add('rp-thumb--active');
    });
  });

  /* ── Quantity stepper ──────────────────────────────── */
  var qtyEl = document.getElementById('rp-qty-val');
  document.getElementById('rp-minus').addEventListener('click', function(){
    var v = parseInt(qtyEl.value,10); if(v>1) qtyEl.value = v-1;
  });
  document.getElementById('rp-plus').addEventListener('click', function(){
    var v = parseInt(qtyEl.value,10); if(v<10) qtyEl.value = v+1;
  });

  /* ── Variant swatches ──────────────────────────────── */
  {% unless product.has_only_default_variant %}
  var variants = {{ product.variants | json }};
  var selectedOpts = [{% for o in product.options_with_values %}"{{ o.selected_value | escape }}"{% unless forloop.last %},{% endunless %}{% endfor %}];

  document.querySelectorAll('.rp-opt-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var idx = parseInt(this.dataset.optIdx, 10);
      selectedOpts[idx] = this.dataset.value;
      this.closest('.rp-option__btns').querySelectorAll('.rp-opt-btn').forEach(function(b){ b.classList.remove('rp-opt-btn--active'); });
      this.classList.add('rp-opt-btn--active');
      var lbl = document.getElementById('rp-opt-' + (idx+1));
      if(lbl) lbl.textContent = this.dataset.value;

      var match = variants.find(function(v){
        return v.options.every(function(o,i){ return o === selectedOpts[i]; });
      });
      if (match) {
        document.getElementById('rp-vid').value = match.id;
        var atcBtn = document.getElementById('rp-atc-btn');
        if (match.available) {
          atcBtn.disabled = false;
          atcBtn.classList.remove('rp-btn--disabled');
          atcBtn.textContent = '🛒 Add to Cart — ' + formatMoney(match.price);
        } else {
          atcBtn.disabled = true;
          atcBtn.classList.add('rp-btn--disabled');
          atcBtn.textContent = 'Sold Out';
        }
      }
    });
  });

  function formatMoney(cents) {
    return '{{ shop.money_format }}'.replace('{{amount}}', (cents/100).toFixed(2))
      .replace('{{amount_no_decimals}}', Math.round(cents/100))
      .replace(/\{\{[^}]+\}\}/, (cents/100).toFixed(2));
  }
  {% endunless %}

  /* ── Buy Now buttons ───────────────────────────────── */
  function buyNow() {
    var vid = document.getElementById('rp-vid').value;
    var qty = document.getElementById('rp-qty-val').value;
    window.location.href = '/checkout?variant='+vid+'&quantity='+qty;
  }
  var bn1 = document.getElementById('rp-buy-now');
  var bn2 = document.getElementById('rp-final-buy-now');
  if(bn1) bn1.addEventListener('click', buyNow);
  if(bn2) bn2.addEventListener('click', buyNow);

  /* ── FAQ accordion ─────────────────────────────────── */
  document.querySelectorAll('.rp-faq__q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var expanded = this.getAttribute('aria-expanded') === 'true';
      // close all
      document.querySelectorAll('.rp-faq__q').forEach(function(b){
        b.setAttribute('aria-expanded','false');
        b.nextElementSibling.style.maxHeight = '0';
      });
      if (!expanded) {
        this.setAttribute('aria-expanded','true');
        var panel = this.nextElementSibling;
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  });

})();
</script>

