<!-- ══════════════════════════════════════════════════════
     9. HOW IT WORKS (3-step)
════════════════════════════════════════════════════════ -->
<section class="rp-section rp-section--dark rp-hiw">
  <div class="rp-container">
    <p class="rp-eyebrow rp-eyebrow--light" style="text-align:center">DEAD SIMPLE SETUP</p>
    <h2 class="rp-h2 rp-h2--light" style="text-align:center">Up and Running in Under 2 Minutes</h2>
    <div class="rp-hiw__steps">
      <div class="rp-hiw__step">
        <div class="rp-hiw__num">01</div>
        <h3>Clip It On</h3>
        <p>Slide the elastic mount over your existing rearview mirror. No screws, no adhesive, no professional install required.</p>
      </div>
      <div class="rp-hiw__arrow">→</div>
      <div class="rp-hiw__step">
        <div class="rp-hiw__num">02</div>
        <h3>Run the Camera Cable</h3>
        <p>Route the rear camera cable along the headliner to the back window. Stick the camera with the included mount. Plug in.</p>
      </div>
      <div class="rp-hiw__arrow">→</div>
      <div class="rp-hiw__step">
        <div class="rp-hiw__num">03</div>
        <h3>Drive Protected</h3>
        <p>Power on. The display activates automatically when you start your car. Adjust brightness, switch to mirror mode — done.</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     10. REVIEWS
════════════════════════════════════════════════════════ -->
<section class="rp-section rp-reviews" id="rp-reviews">
  <div class="rp-container">
    <p class="rp-eyebrow" style="text-align:center">WHAT DRIVERS ARE SAYING</p>
    <h2 class="rp-h2" style="text-align:center">2,841 Verified Reviews</h2>

    <!-- Aggregate row -->
    <div class="rp-reviews__agg">
      <div class="rp-reviews__score-block">
        <span class="rp-reviews__big-score">4.9</span>
        <span class="rp-reviews__big-stars">★★★★★</span>
